# Normalise line endings so Windows checkouts do not churn the diff.
* text=auto eol=lf

# Keep development files out of the Composer dist archive.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
